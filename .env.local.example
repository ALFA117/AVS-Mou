# AVS - Local Development Environment
# Copy to .env.local and fill in real values. Never commit .env.local.

# Solana
SOLANA_NETWORK=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
ANCHOR_WALLET=~/.config/solana/id.json

# MagicBlock Ephemeral Rollup
MAGICBLOCK_ER_RPC_URL=http://127.0.0.1:8123
MAGICBLOCK_ER_WS_URL=ws://127.0.0.1:8123

# Query Filtering Service (privacy simulation layer)
QFS_URL=http://127.0.0.1:9000

# Session Keys
SESSION_KEY_LIFETIME_SECONDS=3600

# VRF (orao-solana-vrf)
VRF_PROGRAM_ID=

# Frontend (Next.js public vars)
NEXT_PUBLIC_SOLANA_NETWORK=localnet
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_MAGICBLOCK_ER_RPC_URL=http://127.0.0.1:8123
