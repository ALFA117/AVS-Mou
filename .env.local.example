# AVS - Development Environment
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# NOTE: solana-test-validator (and MagicBlock's local mb-stack, which wraps
# it) does not run on native Windows — see docs/WINDOWS_NOTES.md. Dev/test
# targets Solana Devnet + MagicBlock's hosted Devnet Ephemeral Rollup instead
# of local infra. Pick a region below (US/EU/Asia); double-check the exact
# RPC/WS paths against https://docs.magicblock.gg/ before relying on them.

# Solana
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json

# MagicBlock Ephemeral Rollup (hosted devnet — no local ER needed)
# US:   https://devnet-us.magicblock.app  (validator MUS3hc9TCw4cGC12vHNoYcCGzJG1txjgQLZWVoeNHNd)
# EU:   https://devnet-eu.magicblock.app  (validator MEUGGrYPxKk17hCr7wpT6s8dtNokZj5U2L57vjYMS8e)
# Asia: https://devnet-as.magicblock.app  (validator MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57)
MAGICBLOCK_ER_RPC_URL=https://devnet-us.magicblock.app
MAGICBLOCK_ER_WS_URL=wss://devnet-us.magicblock.app

# Query Filtering Service — not needed against the hosted devnet ER (only
# required for the local mb-stack privacy simulation layer). Leave blank.
QFS_URL=

# Session Keys
SESSION_KEY_LIFETIME_SECONDS=3600

# VRF (orao-solana-vrf)
VRF_PROGRAM_ID=

# Frontend (Next.js public vars)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MAGICBLOCK_ER_RPC_URL=https://devnet-us.magicblock.app
