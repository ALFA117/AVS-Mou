# AVS - Testnet Environment
# Copy to .env.testnet and fill in real values. Never commit .env.testnet.

SOLANA_NETWORK=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
ANCHOR_WALLET=~/.config/solana/testnet-deploy.json

MAGICBLOCK_ER_RPC_URL=
MAGICBLOCK_ER_WS_URL=

QFS_URL=

SESSION_KEY_LIFETIME_SECONDS=3600

# Relay/faucet backends — see .env.local.example for what these are. Same
# key format (solana-keygen's raw 64-byte secret key as a JSON array).
# Server-only; goes in frontend/.env.testnet, not here.
RELAY_SPONSOR_SECRET_KEY=
FAUCET_AUTHORITY_SECRET_KEY=

VRF_PROGRAM_ID=

NEXT_PUBLIC_SOLANA_NETWORK=testnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.testnet.solana.com
NEXT_PUBLIC_MAGICBLOCK_ER_RPC_URL=
